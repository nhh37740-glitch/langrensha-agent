# 复制为私密的 .env；不要提交真实密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 远程监听必填；用 secrets.token_urlsafe(32) 生成私密入镇口令。
LANGRENSHA_ACCESS_TOKEN=
AI_MAX_ROUNDS=3
# HTTPS 部署为 true；仅本机 HTTP 测试为 false。
COOKIE_SECURE=false
# 默认持久化到 临时/完整对局/对局.sqlite3；容器由 compose 指定 /data。
# 反向代理地址须匹配实际受控代理；不要信任任意客户端转发头。
FORWARDED_ALLOW_IPS=127.0.0.1
# 生产 HTTPS 地址（不含路径或自定义端口）；本机 TLS 验收用 localhost。
SITE_ADDRESS=
# 生产部署可指定本机已构建的镜像名，默认 langrensha-agent:local。
# LANGRENSHA_IMAGE=langrensha-agent:v0.4.0
# 若与现有网络冲突，同时修改下面三项。
# MIST_PROXY_SUBNET=172.30.91.0/24
# MIST_PROXY_ADDRESS=172.30.91.2

# MIST_APPLICATION_ADDRESS=172.30.91.3
