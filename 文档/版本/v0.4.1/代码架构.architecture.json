  "cards": [
    {
      "dot": "cyan",
      "title": "请求生命周期",
      "items": [
        "main.js 产生 phase_id、expected_version 与 request_id",
        "PlayerSession 将操作者固定到已认证席位",
        "GameService 在事务内 load → reduce_action → save"
      ]
    },
    {
      "dot": "rose",
      "title": "模型没有裁定权",
      "items": [
        "查询调用 session.query，行动调用 session.submit",
        "原生工具仍核对阶段、版本、权限、目标和请求回执",
        "失败或耗尽轮数进入受控弃权，并写主持审计"
      ]
    },
    {
      "dot": "amber",
      "title": "图的读取方式",
      "items": [
        "箭头表示调用或读写职责，返回值沿调用返回，不另画回复线",
        "full_game.player_view 先按受众/死亡时间过滤，呈现层不是授权入口",
        "札记只消费已检索来源，不访问数据库，也不自动发言"
      ]
    },
    {
      "dot": "emerald",
      "title": "范围与边界",
      "items": [
        "源码调用图，不替代已有 HTTPS/备份与发布架构图",
        "SQLite 保存 JSON 状态和回执，不是完整事件溯源实现",
        "rules.py 仍含历史演练 reducer；完整游戏使用 full_game.py"
      ]
    }
  ]
}
