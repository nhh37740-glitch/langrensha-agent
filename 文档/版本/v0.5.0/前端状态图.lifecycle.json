  "cards": [
    {
      "dot": "cyan",
      "title": "状态来源与权限",
      "items": [
        "main.js 把受限视图写入 html 的 data-mode/phase/turn/alive/error/motion",
        "CSS 与 Phaser 只消费公开状态；隐藏身份与私聊不会进入场景",
        "私密记录仅展示服务器已过滤给当前玩家的事件"
      ]
    },
    {
      "dot": "amber",
      "title": "行动与等待",
      "items": [
        "轮到时显示回合徽标与行动区顶光；提交仍走既有 HTTP API",
        "非真人待行只显示思索提示，自动推进不跳过真人",
        "断线只影响请求重试，不改变对局状态或规则裁定"
      ]
    },
    {
      "dot": "emerald",
      "title": "减少动效降级",
      "items": [
        "prefers-reduced-motion 与运行期开关都写入 data-motion=reduced",
        "连续漂浮、闪烁与扫光停止，状态切换即时完成",
        "Playwright 用例验证降级后仍可入镇、行动与刷新恢复"
      ]
    }
  ]
